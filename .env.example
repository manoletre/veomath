# Production Firebase Web config. This API key is public and is NOT the OpenAI key.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=

# Server only. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Local emulator mode is supplied by `pnpm dev:local`.
# Production: use Application Default Credentials for Firebase Admin.
